# Clerk — get these from https://dashboard.clerk.com → API Keys
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Clerk webhooks — Dashboard → Webhooks → Add endpoint, then copy signing secret
CLERK_WEBHOOK_SECRET=whsec_...

# Machine-to-machine API key for workers and n8n calls.
# Generate a strong random string (e.g. `openssl rand -hex 32`).
INTERNAL_API_KEY=

# Platform API base URL — used by `requireService` / `require_service` to
# look up which services each org is entitled to. Leave unset in dev to
# fail open (with a warning); in production an unset / unreachable URL
# fails closed.
# Example: PLATFORM_API_URL=https://api.konstant-studio.com
PLATFORM_API_URL=
