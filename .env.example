# Clerk — get these from https://dashboard.clerk.com → API Keys
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Clerk webhooks — Dashboard → Webhooks → Add endpoint, then copy signing secret
CLERK_WEBHOOK_SECRET=whsec_...

# Machine-to-machine API key for workers and n8n calls.
# Generate a strong random string (e.g. `openssl rand -hex 32`).
INTERNAL_API_KEY=

# Platform API base URL — used by `requireService` / `require_service` to
# look up which services each org is entitled to. Leave unset in dev to
# fail open (with a warning); in production an unset / unreachable URL
# fails closed.
# Example: PLATFORM_API_URL=https://api.konstant-studio.com
PLATFORM_API_URL=

# --- v2: control-plane authorization (@konstant-studio/auth/v2) --------------
# The catalog service this app is (docs, video, crm, jobs, mail, ...).
AUTH_SERVICE=
# This service's OWN key for the control plane (stgs_..., bound to its catalog
# service, with only the routes it needs). Replaces INTERNAL_API_KEY above,
# which stays supported but deprecated until the platform's ACCEPT_SHARED_KEY=false cutover.
PLATFORM_SERVICE_KEY=
# Public values of the Clerk instance (no secret). The azp list is REQUIRED:
# without it the library refuses to start.
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=
# CLERK_AUDIENCE=            # only if session tokens carry an aud
# SNAPSHOT_TTL_SECONDS=30
# SNAPSHOT_STALE_READ_TTL_SECONDS=300
# AUTH_EVENT_POLL_SECONDS=5
# AUTH_STEP_UP_MAX_AGE_MINUTES=10
# AUTH_SERVICE_KEYS=stub     # switch to `platform` once the platform resolves stgs_ keys (C0b2)
