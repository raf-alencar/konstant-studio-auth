    {"id": "agent-key-expired",         "desc": "expired key",
     "who": {"key": "agent_acme_expired"}, "ask": {"permission": "docs:read"},
     "expect": {"allow": false, "reason": "key_expired", "status": 401, "tenant": null, "source": "live"}},
    {"id": "agent-key-unknown",         "desc": "well-formed but unknown agent key",
     "who": {"key": "agent_unknown"}, "ask": {"permission": "docs:read"},
     "expect": {"allow": false, "reason": "key_not_found", "status": 401, "tenant": null, "source": "live"}},
    {"id": "guest-read-live",           "desc": "guests may read",
     "who": {"key": "guest_acme_active"}, "ask": {"permission": "docs:read"},
     "expect": {"allow": true, "reason": "allowed", "status": 200, "tenant": "acme", "roles": ["operator", "viewer"], "source": "live"}},
    {"id": "guest-write-denied",        "desc": "guests are read-only even with an operator role",
     "who": {"key": "guest_acme_active"}, "ask": {"permission": "docs:write"},
     "expect": {"allow": false, "reason": "principal_kind_restricted", "status": 403, "tenant": "acme", "source": "live"}},

    {"id": "clerk-expired",             "desc": "expired session token",
     "who": {"clerk": "alice", "token": {"exp_in_s": -600}}, "ask": {"permission": "docs:read", "tenant": "acme"},
     "expect": {"allow": false, "reason": "token_expired", "status": 401, "tenant": null, "source": "none"}},
    {"id": "clerk-wrong-azp",           "desc": "azp is mandatory and must be listed",
     "who": {"clerk": "alice", "token": {"azp": "https://evil.test"}}, "ask": {"permission": "docs:read", "tenant": "acme"},
     "expect": {"allow": false, "reason": "token_invalid", "status": 401, "tenant": null, "source": "none"}},
    {"id": "clerk-missing-azp",         "desc": "a token without azp is not ours",
     "who": {"clerk": "alice", "token": {"azp": null}}, "ask": {"permission": "docs:read", "tenant": "acme"},
     "expect": {"allow": false, "reason": "token_invalid", "status": 401, "tenant": null, "source": "none"}},
    {"id": "clerk-wrong-issuer",        "desc": "issuer mismatch",
     "who": {"clerk": "alice", "token": {"iss": "https://other-clerk.test"}}, "ask": {"permission": "docs:read", "tenant": "acme"},
     "expect": {"allow": false, "reason": "token_invalid", "status": 401, "tenant": null, "source": "none"}},
    {"id": "clerk-wrong-signature",     "desc": "signed by a key that is not in the JWKS",
     "who": {"clerk": "alice", "token": {"sign_with": "foreign"}}, "ask": {"permission": "docs:read", "tenant": "acme"},
     "expect": {"allow": false, "reason": "token_invalid", "status": 401, "tenant": null, "source": "none"}},
    {"id": "clerk-unknown-kid",         "desc": "kid not in the JWKS",
     "who": {"clerk": "alice", "token": {"kid": "no-such-kid"}}, "ask": {"permission": "docs:read", "tenant": "acme"},
     "expect": {"allow": false, "reason": "token_invalid", "status": 401, "tenant": null, "source": "none"}},
    {"id": "clerk-unlisted-audience",   "desc": "an aud we did not list is refused",
     "who": {"clerk": "alice", "token": {"aud": "https://not-listed.test"}}, "ask": {"permission": "docs:read", "tenant": "acme"},
     "expect": {"allow": false, "reason": "token_invalid", "status": 401, "tenant": null, "source": "none"}},
    {"id": "clerk-issued-in-the-future", "desc": "iat beyond the clock tolerance: the platform's verifier refuses it, so must we",
     "who": {"clerk": "alice", "token": {"iat_in_s": 600}}, "ask": {"permission": "docs:read", "tenant": "acme"},
     "expect": {"allow": false, "reason": "token_invalid", "status": 401, "tenant": null, "source": "none"}},
    {"id": "clerk-not-yet-valid",       "desc": "nbf in the future",
     "who": {"clerk": "alice", "token": {"nbf_in_s": 600}}, "ask": {"permission": "docs:read", "tenant": "acme"},
     "expect": {"allow": false, "reason": "token_invalid", "status": 401, "tenant": null, "source": "none"}},
    {"id": "clerk-alg-none",            "desc": "unsigned token",
     "who": {"clerk": "alice", "token": {"alg": "none"}}, "ask": {"permission": "docs:read", "tenant": "acme"},
     "expect": {"allow": false, "reason": "token_invalid", "status": 401, "tenant": null, "source": "none"}},
    {"id": "clerk-alg-hs256",           "desc": "HMAC token (algorithm confusion)",
     "who": {"clerk": "alice", "token": {"alg": "HS256"}}, "ask": {"permission": "docs:read", "tenant": "acme"},
     "expect": {"allow": false, "reason": "token_invalid", "status": 401, "tenant": null, "source": "none"}},
    {"id": "credential-missing",        "desc": "no credential at all",
     "who": {"none": true}, "parity": false, "parity_note": "the platform endpoint rejects a request with no credential with 400, not a decision",
     "ask": {"permission": "docs:read", "tenant": "acme"},
     "expect": {"allow": false, "reason": "no_credential", "status": 401, "tenant": null, "source": "none"}},
    {"id": "bearer-not-a-key-or-jwt",   "desc": "a bearer that is neither a known key nor a JWT falls through to Clerk validation: clean 401 (CRM iOS path)",
     "who": {"bearer": "not-a-key-and-not-a-jwt"}, "parity": false, "parity_note": "the platform treats a bare string as `credential` (unsupported_credential); the library routes it to Clerk validation by design",
     "ask": {"permission": "docs:read", "tenant": "acme"},
     "expect": {"allow": false, "reason": "token_invalid", "status": 401, "tenant": null, "source": "none"}},

    {"id": "down-sensitive",            "desc": "platform unreachable: sensitive actions fail closed",
     "platform": "down", "who": {"clerk": "amy"}, "ask": {"permission": "docs:delete", "tenant": "acme"},
     "expect": {"allow": false, "reason": "platform_unavailable", "status": 503, "tenant": null, "source": "none"}},
    {"id": "down-read-fresh-cache",     "desc": "platform unreachable, cache still fresh: reads answered offline",
     "platform": "down", "cache_age_s": 5, "who": {"clerk": "alice"}, "ask": {"permission": "docs:read", "tenant": "acme"},
     "expect": {"allow": true, "reason": "allowed", "status": 200, "tenant": "acme", "roles": ["operator"], "source": "offline"}},
    {"id": "down-read-stale-within",    "desc": "past the TTL but inside the stale-read window: reads still served",
     "platform": "down", "cache_age_s": 120, "who": {"clerk": "alice"}, "ask": {"permission": "docs:read", "tenant": "acme"},
     "expect": {"allow": true, "reason": "allowed", "status": 200, "tenant": "acme", "roles": ["operator"], "source": "offline", "stale": true}},
    {"id": "down-read-stale-beyond",    "desc": "beyond the stale-read window: fail closed",
     "platform": "down", "cache_age_s": 400, "who": {"clerk": "alice"}, "ask": {"permission": "docs:read", "tenant": "acme"},
     "expect": {"allow": false, "reason": "platform_unavailable", "status": 503, "tenant": null, "source": "none"}},
    {"id": "down-write-stale",          "desc": "only read-category checks may be served stale",
     "platform": "down", "cache_age_s": 120, "who": {"clerk": "alice"}, "ask": {"permission": "docs:write", "tenant": "acme"},
     "expect": {"allow": false, "reason": "platform_unavailable", "status": 503, "tenant": null, "source": "none"}},
    {"id": "down-agent",                "desc": "agent keys cannot be checked without the platform",
     "platform": "down", "cache_age_s": 5, "who": {"key": "agent_acme_active"}, "ask": {"permission": "docs:read"},
     "expect": {"allow": false, "reason": "platform_unavailable", "status": 503, "tenant": null, "source": "none"}},
    {"id": "down-cold-cache",           "desc": "no cache and no platform",
     "platform": "down", "cache_age_s": null, "who": {"clerk": "alice"}, "ask": {"permission": "docs:read", "tenant": "acme"},
     "expect": {"allow": false, "reason": "platform_unavailable", "status": 503, "tenant": null, "source": "none"}},

    {"id": "service-key-resolves",      "desc": "a valid service key resolves to a service principal {kind: service, service, routes, tenant: null}",
     "pending": "pending-platform: C0b2 must resolve stgs_ keys through /v1/principals/resolve",
     "who": {"key": "svc_docs_active"}, "resolve_only": true, "ask": {},
     "expect": {"allow": true, "status": 200, "principal": {"kind": "service", "service": "docs", "tenant": null, "routes": ["GET /v1/authorize/snapshot", "POST /v1/authorize"]}}},
    {"id": "service-key-tenant-denied", "desc": "a service key is denied by default for every tenant-scoped permission",
     "pending": "pending-platform: C0b2 must decide service principals in /v1/authorize",
     "who": {"key": "svc_docs_active"}, "ask": {"permission": "docs:read", "tenant": "acme"},
     "expect": {"allow": false, "status": 403}},
    {"id": "service-key-approver-denied", "desc": "a service key can never hold an approver permission",
     "pending": "pending-platform: C0b2 must decide service principals in /v1/authorize",
     "who": {"key": "svc_docs_active"}, "ask": {"permission": "social:approve", "tenant": "acme"},
     "expect": {"allow": false, "status": 403}},
    {"id": "service-key-revoked",       "desc": "revoked service key",
     "pending": "pending-platform: C0b2 must resolve stgs_ keys",
     "who": {"key": "svc_docs_revoked"}, "resolve_only": true, "ask": {},
     "expect": {"allow": false, "reason": "key_revoked", "status": 401}},
    {"id": "service-key-expired",       "desc": "expired service key",
     "pending": "pending-platform: C0b2 must resolve stgs_ keys",
     "who": {"key": "svc_docs_expired"}, "resolve_only": true, "ask": {},
     "expect": {"allow": false, "reason": "key_expired", "status": 401}}
  ]
}
